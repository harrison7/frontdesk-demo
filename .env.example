# Copy to .env (or .env.local) and adjust. Every value has a safe default, so
# the demo runs with no .env at all using the offline fake provider.

# --- AI provider ---------------------------------------------------------
# "fake"   = deterministic, offline, no API key (default; used by tests + CI)
# "openai" = any OpenAI-compatible API (OpenAI, Azure-compatible gateways,
#            Ollama, LM Studio, vLLM, OpenRouter, ...)
AI_PROVIDER=fake

# Only used when AI_PROVIDER=openai.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Vector size. Must match the embedding model (text-embedding-3-small = 1536).
# The fake provider uses the same size so switching providers needs no schema
# change, only a re-ingest (which happens automatically).
EMBEDDING_DIMENSIONS=1536

# --- Retrieval -----------------------------------------------------------
# Where chunks live: "pg" (Postgres + pgvector, default) or "memory"
# (embeds data/*.md at startup; handy when Docker isn't available).
VECTOR_STORE=pg
DATABASE_URL=postgres://frontdesk:frontdesk@localhost:5433/frontdesk

# Chunks scoring below this cosine similarity are treated as "not relevant".
# Leave unset to use the provider's default (fake: 0.08, openai: 0.30).
# RETRIEVAL_MIN_SCORE=
RETRIEVAL_TOP_K=4

# --- Widget / API --------------------------------------------------------
# Comma-separated origins allowed to call /api/chat from another site
# (for embedding the widget elsewhere). Same-origin always works.
ALLOWED_ORIGINS=
